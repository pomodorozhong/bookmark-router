{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Indie bookmark processing dataset",
  "description": "Structural schema. Cross-record integrity and completion rules must also be checked by the application.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "created_on": {
          "type": "string",
          "format": "date"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "filename": {
              "type": "string",
              "minLength": 1
            },
            "original_path": {
              "type": "string",
              "minLength": 1
            },
            "export_on": {
              "type": "string",
              "format": "date"
            },
            "row_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "filename",
            "original_path",
            "export_on",
            "row_count"
          ],
          "additionalProperties": false
        },
        "previous_review_on": {
          "type": "string",
          "format": "date"
        },
        "issue_catalog_refreshed_on": {
          "type": "string",
          "format": "date"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "title",
        "created_on",
        "timezone",
        "repository",
        "source",
        "previous_review_on",
        "issue_catalog_refreshed_on",
        "revision",
        "updated_at",
        "notes"
      ],
      "additionalProperties": false
    },
    "category_review": {
      "type": "object",
      "properties": {
        "original_distribution": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string",
                "minLength": 1
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "category",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "assessment": {
          "type": "string",
          "minLength": 1
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "taxonomy_status": {
          "type": "string",
          "enum": [
            "proposed",
            "adopted"
          ]
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/category"
          }
        }
      },
      "required": [
        "original_distribution",
        "assessment",
        "rules",
        "taxonomy_status",
        "categories"
      ],
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "properties": {
        "review_statuses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "dispositions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "placement_statuses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "completion_rule": {
          "type": "string",
          "minLength": 1
        },
        "category_policy": {
          "type": "string",
          "minLength": 1
        },
        "initialization": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "review_statuses",
        "dispositions",
        "placement_statuses",
        "completion_rule",
        "category_policy",
        "initialization"
      ],
      "additionalProperties": false
    },
    "issue_catalog": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "references_for_existing_issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recommendation"
      }
    },
    "bookmarks_worth_their_own_issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proposal"
      }
    },
    "duplicate_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/duplicateGroup"
      }
    },
    "bookmarks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bookmark"
      }
    },
    "node_progress": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/progress_status"
      }
    }
  },
  "required": [
    "schema_version",
    "dataset_id",
    "metadata",
    "category_review",
    "workflow",
    "issue_catalog",
    "references_for_existing_issues",
    "bookmarks_worth_their_own_issues",
    "duplicate_groups",
    "bookmarks"
  ],
  "additionalProperties": false,
  "$defs": {
    "category": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "label",
        "group"
      ],
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "OPEN",
            "CLOSED"
          ]
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "body_snapshot": {
          "type": "string"
        },
        "github_updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "snapshot_on": {
          "type": "string",
          "format": "date"
        },
        "scope": {
          "type": "string",
          "enum": [
            "indie_hacking_issue",
            "related_unlabeled_issue",
            "user_added_issue"
          ]
        }
      },
      "required": [
        "number",
        "title",
        "url",
        "state",
        "labels",
        "body_snapshot",
        "github_updated_at",
        "snapshot_on",
        "scope"
      ],
      "additionalProperties": false
    },
    "recommendation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "bookmark_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "issue_number": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "caveat": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "type": "string",
          "enum": [
            "previous_review",
            "current_issue_snapshot",
            "current_catalog_extension",
            "user"
          ]
        },
        "recommendation": {
          "type": "string",
          "enum": [
            "add_reference",
            "avoid_duplicate",
            "consider_context"
          ]
        },
        "presence": {
          "type": "string",
          "enum": [
            "reference_present",
            "equivalent_reference_present",
            "not_observed_in_issue_snapshot"
          ]
        },
        "alternative_proposal_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "bookmark_id",
        "issue_number",
        "label",
        "reason",
        "caveat",
        "origin",
        "recommendation",
        "presence",
        "alternative_proposal_id"
      ],
      "additionalProperties": false
    },
    "proposal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "seed_bookmark_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "uniqueItems": true
        },
        "overlap_with_existing_issues": {
          "type": "string",
          "minLength": 1
        },
        "related_issue_numbers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "suggested_labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "origin": {
          "type": "string",
          "enum": [
            "previous_review",
            "user"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "suggested",
            "approved",
            "created",
            "rejected"
          ]
        },
        "approved_seed_bookmark_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "uniqueItems": true
        },
        "created_issue_number": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "created_issue_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "user_notes": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "rationale",
        "questions",
        "seed_bookmark_ids",
        "overlap_with_existing_issues",
        "related_issue_numbers",
        "suggested_labels",
        "origin",
        "status",
        "approved_seed_bookmark_ids",
        "created_issue_number",
        "created_issue_url",
        "user_notes"
      ],
      "additionalProperties": false
    },
    "duplicateGroup": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "same_post",
            "content_mirrors"
          ]
        },
        "bookmark_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "uniqueItems": true
        },
        "proposed_canonical_bookmark_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "confirmed",
            "rejected"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "bookmark_ids",
        "proposed_canonical_bookmark_id",
        "reason",
        "status"
      ],
      "additionalProperties": false
    },
    "original": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "tags": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "cover": {
          "type": "string"
        },
        "favorite": {
          "type": "string"
        },
        "category": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "note",
        "excerpt",
        "url",
        "tags",
        "created",
        "cover",
        "favorite",
        "category"
      ],
      "additionalProperties": false
    },
    "linkCheck": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "available",
            "redirected",
            "redirected_to_homepage",
            "not_found",
            "access_restricted",
            "rate_limited",
            "compromised",
            "not_checked",
            "error"
          ]
        },
        "resolved_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        },
        "observed_on": {
          "type": "string",
          "format": "date"
        },
        "origin": {
          "type": "string",
          "enum": [
            "previous_review",
            "user",
            "app_check"
          ]
        },
        "requires_recheck": {
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "resolved_url",
        "note",
        "observed_on",
        "origin",
        "requires_recheck"
      ],
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "properties": {
        "proposed_category_id": {
          "type": "string",
          "minLength": 1
        },
        "proposed_secondary_category_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "correction_kind": {
          "type": "string",
          "enum": [
            "reassign",
            "refine"
          ]
        },
        "origin": {
          "type": "string",
          "enum": [
            "previous_review_explicit_correction",
            "topic_normalization_for_storage",
            "user"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "approved_category_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_secondary_category_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "revised"
          ]
        }
      },
      "required": [
        "proposed_category_id",
        "proposed_secondary_category_ids",
        "correction_kind",
        "origin",
        "reason",
        "approved_category_id",
        "approved_secondary_category_ids",
        "status"
      ],
      "additionalProperties": false
    },
    "duplicateReview": {
      "type": "object",
      "properties": {
        "possible_duplicate_of": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "confirmed_duplicate_of": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_mirror_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "no_known_duplicate",
            "confirmed",
            "rejected"
          ]
        }
      },
      "required": [
        "possible_duplicate_of",
        "confirmed_duplicate_of",
        "content_mirror_group",
        "status"
      ],
      "additionalProperties": false
    },
    "sourceReview": {
      "type": "object",
      "properties": {
        "strength": {
          "type": "string",
          "enum": [
            "thin_research_lead",
            "research_lead",
            "reference_resource",
            "requires_content_review",
            "firsthand_case",
            "secondary_analysis"
          ]
        },
        "note": {
          "type": "string"
        },
        "historical_link_check": {
          "anyOf": [
            {
              "$ref": "#/$defs/linkCheck"
            },
            {
              "type": "null"
            }
          ]
        },
        "latest_link_check": {
          "anyOf": [
            {
              "$ref": "#/$defs/linkCheck"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "strength",
        "note",
        "historical_link_check",
        "latest_link_check"
      ],
      "additionalProperties": false
    },
    "triage": {
      "type": "object",
      "properties": {
        "suggested_next_action": {
          "type": "string",
          "enum": [
            "review",
            "review_for_existing_issue",
            "choose_existing_or_proposed_issue",
            "review_for_new_issue",
            "verify_existing_reference",
            "keep_outside_indie_issues",
            "hold_as_research_lead",
            "resolve_link_before_attachment",
            "review_duplicate"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": [
            "high",
            "normal",
            "low"
          ]
        }
      },
      "required": [
        "suggested_next_action",
        "reason",
        "priority"
      ],
      "additionalProperties": false
    },
    "selectedTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "existing_issue"
            },
            "issue_number": {
              "type": "integer",
              "minimum": 1
            },
            "placement_status": {
              "type": "string",
              "enum": [
                "pending",
                "added",
                "already_present"
              ]
            },
            "confirmation_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "confirmed_on": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ]
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "issue_number",
            "placement_status",
            "confirmation_url",
            "confirmed_on",
            "note"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "proposed_issue"
            },
            "proposal_id": {
              "type": "string",
              "minLength": 1
            },
            "placement_status": {
              "type": "string",
              "enum": [
                "pending",
                "added",
                "already_present"
              ]
            },
            "confirmation_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "confirmed_on": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ]
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "proposal_id",
            "placement_status",
            "confirmation_url",
            "confirmed_on",
            "note"
          ],
          "additionalProperties": false
        }
      ]
    },
    "processing": {
      "type": "object",
      "properties": {
        "review_status": {
          "type": "string",
          "enum": [
            "unreviewed",
            "reviewing",
            "decided"
          ]
        },
        "disposition": {
          "type": "string",
          "enum": [
            "undecided",
            "attach",
            "keep",
            "skip",
            "duplicate",
            "defer"
          ]
        },
        "selected_targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selectedTarget"
          }
        },
        "user_notes": {
          "type": "string"
        },
        "defer_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "review_status",
        "disposition",
        "selected_targets",
        "user_notes",
        "defer_reason",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "historyEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": [
            "string",
            "null"
          ]
        },
        "previous_value": {},
        "new_value": {},
        "note": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "at",
        "action",
        "field",
        "previous_value",
        "new_value",
        "note"
      ],
      "additionalProperties": false
    },
    "bookmark": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "original": {
          "$ref": "#/$defs/original"
        },
        "display_title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "normalized_url": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "favorite": {
          "type": "boolean"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "social_post",
            "video",
            "discussion",
            "podcast",
            "resource",
            "article_or_page"
          ]
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "source_review": {
          "$ref": "#/$defs/sourceReview"
        },
        "duplicate_review": {
          "$ref": "#/$defs/duplicateReview"
        },
        "triage": {
          "$ref": "#/$defs/triage"
        },
        "processing": {
          "$ref": "#/$defs/processing"
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/historyEvent"
          }
        }
      },
      "required": [
